[project]
name = "{{ name }}"
version = "0.1.0"
description = "{{ description }}"
requires-python = ">=3.14"
dependencies = ["homelab-common", "alembic"]

[tool.uv.sources]
homelab-common = { git = "https://github.com/navaneethkrishna30/homelab-common", tag = "{{ library_tag }}" }

[build-system]
requires = ["uv_build>=0.13,<0.14"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ package }}"

[dependency-groups]
dev = ["ruff", "pyright", "pytest", "pytest-asyncio", "httpx"]

[tool.ruff]
line-length = 100
target-version = "py314"

[tool.ruff.lint]
select = ["E", "W", "F", "I", "N", "B", "UP", "ANN", "C90", "C416", "PLR0912", "PLR0915", "PLR2004", "S608"]

[tool.ruff.lint.mccabe]
max-complexity = 10

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["PLR2004"]  # expected values in asserts read better inline

[tool.pyright]
typeCheckingMode = "strict"
enableTypeIgnoreComments = false
pythonVersion = "3.14"
include = ["src", "tests", "migrations"]

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
testpaths = ["tests"]
