"""Alembic environment: async, forward only; the version table lives in the service schema."""

import asyncio

from alembic import context
from homelab_common import load_config
from sqlalchemy.engine import Connection
from sqlalchemy.ext.asyncio import create_async_engine
from {{ package }}.models import Base
from {{ package }}.settings import Settings

settings = load_config(Settings)


def run_migrations(connection: Connection) -> None:
    context.configure(
        connection=connection,
        target_metadata=Base.metadata,
        version_table_schema=settings.database_schema,
        compare_type=True,
    )
    with context.begin_transaction():
        context.run_migrations()


async def run_async_migrations() -> None:
    engine = create_async_engine(
        settings.database_url,
        connect_args={"server_settings": {"search_path": settings.database_schema}},
    )
    async with engine.connect() as connection:
        await connection.run_sync(run_migrations)
        await connection.commit()
    await engine.dispose()


asyncio.run(run_async_migrations())
